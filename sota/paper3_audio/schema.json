{
  "paper": "paper3_audio",
  "title": "LinguoMT-Audio: Audio Preprocessing and Robustness for African Speech Translation",
  "paper_mode": "audio",
  "paper_specific_required": ["audio_condition"],
  "paper_specific_optional": ["noise_type", "snr_db", "vad_applied", "sample_rate_hz"],
  "field_definitions": {
    "paper_title":    { "required": true,  "type": "str",   "description": "Full paper title" },
    "authors":        { "required": true,  "type": "str",   "description": "First author + et al." },
    "year":           { "required": true,  "type": "int",   "description": "4-digit publication year" },
    "model":          { "required": true,  "type": "str",   "description": "Model name" },
    "dataset":        { "required": true,  "type": "str",   "description": "Evaluation dataset name" },
    "language":       { "required": true,  "type": "str",   "description": "Display language name matching our system output" },
    "direction":      { "required": true,  "type": "str",   "description": "'Source → English' or 'English → Source'" },
    "metric":         { "required": true,  "type": "str",   "description": "One of: BLEU, ChrF, WER, CER" },
    "score":          { "required": true,  "type": "float", "description": "Numeric score — must be a number" },
    "citation_key":   { "required": true,  "type": "str",   "description": "BibTeX citation key" },
    "audio_condition":{ "required": true,  "type": "str",   "description": "Audio processing label: 'clean', 'normalized', 'trimmed', 'chunked', 'noisy'" },
    "notes":          { "required": false, "type": "str",   "description": "Details about the audio condition" },
    "noise_type":     { "required": false, "type": "str",   "description": "Type of noise added: 'babble', 'music', 'street', 'none'" },
    "snr_db":         { "required": false, "type": "float", "description": "Signal-to-noise ratio in dB (e.g. 10.0, 20.0)" },
    "vad_applied":    { "required": false, "type": "bool",  "description": "Whether voice activity detection was applied: true or false" },
    "sample_rate_hz": { "required": false, "type": "int",   "description": "Audio sample rate used for evaluation (typically 16000)" }
  }
}
